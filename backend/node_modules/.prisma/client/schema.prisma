// Prisma schema for EcoCircuit Smart E-Waste Management Platform
// Target Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  CITIZEN
  COLLECTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PickupStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  COLLECTED
  DELIVERED_TO_RECYCLER
  COMPLETED
  CANCELLED
  FAILED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(255)
  phone     String   @db.VarChar(30)
  role      UserRole @default(CITIZEN)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  collectorProfile CollectorProfile?
  citizenPickups   PickupRequest[]       @relation("CitizenPickups")
  assignedPickups  PickupRequest[]       @relation("CollectorPickups")
  statusHistory    PickupStatusHistory[]

  @@index([email])
  @@index([role])
}

model CollectorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  businessName       String             @db.VarChar(180)
  contactInfo        String             @db.VarChar(255)
  verificationStatus VerificationStatus @default(PENDING)
  serviceAreas       String[] // Array of covered localities or pincodes
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model WasteCategory {
  id                   String   @id @default(uuid())
  name                 String   @unique @db.VarChar(100)
  description          String   @db.Text
  disposalInstructions String   @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  // Relations
  items PickupItem[]
}

model PickupRequest {
  id                String       @id @default(uuid())
  citizenId         String
  collectorId       String?
  pickupAddress     String       @db.VarChar(255)
  locality          String       @db.VarChar(120)
  pincode           String       @db.VarChar(20)
  preferredDate     DateTime     @db.Date
  preferredTimeSlot String       @db.VarChar(60) // "Morning (08:00 AM - 12:00 PM)", etc.
  currentStatus     PickupStatus @default(PENDING)
  createdAt         DateTime     @default(now()) @db.Timestamptz
  updatedAt         DateTime     @updatedAt @db.Timestamptz

  // Relations
  citizen       User                  @relation("CitizenPickups", fields: [citizenId], references: [id], onDelete: Restrict)
  collector     User?                 @relation("CollectorPickups", fields: [collectorId], references: [id], onDelete: SetNull)
  items         PickupItem[]
  statusHistory PickupStatusHistory[]

  @@index([currentStatus])
  @@index([citizenId])
  @@index([collectorId])
  @@index([pincode])
}

model PickupItem {
  id              String   @id @default(uuid())
  pickupRequestId String
  wasteCategoryId String
  quantity        Int      @default(1)
  estimatedWeight Float // in kilograms
  description     String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz

  // Relations
  pickupRequest PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  category      WasteCategory @relation(fields: [wasteCategoryId], references: [id], onDelete: Restrict)

  @@index([pickupRequestId])
}

model CollectionCentre {
  id                      String             @id @default(uuid())
  name                    String             @db.VarChar(150)
  address                 String             @db.VarChar(255)
  latitude                Float
  longitude               Float
  contactDetails          String             @db.VarChar(120)
  acceptedWasteCategories String[] // List of category names or IDs
  verificationStatus      VerificationStatus @default(VERIFIED)
  createdAt               DateTime           @default(now()) @db.Timestamptz
  updatedAt               DateTime           @updatedAt @db.Timestamptz

  @@index([verificationStatus])
}

model PickupStatusHistory {
  id              String        @id @default(uuid())
  pickupRequestId String
  previousStatus  PickupStatus?
  newStatus       PickupStatus
  changedBy       String // User ID of citizen, collector, or admin making the change
  reason          String?       @db.VarChar(255)
  timestamp       DateTime      @default(now()) @db.Timestamptz

  // Relations
  pickupRequest PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  actor         User          @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([pickupRequestId])
  @@index([timestamp])
}
